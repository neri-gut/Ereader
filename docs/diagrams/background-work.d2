direction: down

ui_thread: Hilo de UI {
  compose: Compose\nestado del lector
  pdf_view: PdfRenderer\nun hilo dedicado dentro del proceso
}

proceso: Corrutinas del proceso {
  io: "Dispatchers.IO\ncopia del PDF, hash, portadas, Room, DataStore"
  cpu: "Dispatchers.Default\nnormalizar párrafos y sintetizar Piper"
  vm: "ReaderViewModel\nla extracción se cancela al abrir otro PDF"
  audio: "TtsController\nse detiene si el proceso muere"
}

servicio: Servicio en primer plano {
  download: "ModelDownloadService\ntipo dataSync\ndescarga de voces Piper"
}

muere: "No sobrevive al proceso:\nextracción a medias, audio y el visor PDF.\nLa caché evita repetir PdfBox al reabrir." {
  shape: rectangle
}

ui_thread.compose -> proceso.vm: StateFlow
proceso.io -> proceso.cpu: texto de cada página
proceso.vm -> muere
proceso.audio -> muere
servicio.download -> proceso.io: archivos en filesDir/models
